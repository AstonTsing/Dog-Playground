<mujoco model="scene">
    <include file="dog.xml"/>

    <visual>
        <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.4 0.4 0.4"/>
        <rgba haze="0.55 0.55 0.55 1"/>
        <global azimuth="160" elevation="-20"/>
        <quality shadowsize="8192"/>
    </visual>

    <asset>
        <!-- Light grey-white sky -->
        <texture type="skybox" builtin="gradient" rgb1="0.75 0.78 0.82" rgb2="0.92 0.92 0.92" width="800" height="800"/>
        <!-- Clean tile floor: light blue-grey with white grid lines -->
        <texture type="2d" name="groundplane" builtin="checker" mark="cross"
            rgb1="0.68 0.72 0.78" rgb2="0.58 0.62 0.68" markrgb="0.85 0.85 0.88"
            width="256" height="256"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="40 40"
            reflectance="0.3" specular="0.5" shininess="0.4" rgba="0.68 0.72 0.78 1"/>
        <!-- 4-sided pyramid staircase: 5.2x5.2m area, 21 steps per side -->
        <!-- Each step: 5cm high, ~13cm wide. Edges=ground, center=top (1m) -->
        <hfield name="hfield" file="assets/stairs_hfield.png" size="2.6 2.6 1.0 0.001"/>
    </asset>

    <worldbody>
        <body name="floor">
            <geom name="floor" type="hfield" hfield="hfield" material="groundplane" contype="1" conaffinity="0"
                priority="1" friction="0.8" condim="3"/>
        </body>
    </worldbody>

    <keyframe>
        <!-- Spawn near the top of the pyramid (center = 1m height) -->
        <key name="home"
            qpos="
    0 0 1.3
    1 0 0 0
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
"
            ctrl="
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
"/>
    </keyframe>
</mujoco>
