<mujoco model="scene">
    <include file="dog.xml"/>

    <visual>
        <headlight diffuse="0.8 0.8 0.8" ambient="0.45 0.45 0.45" specular="0.3 0.3 0.3"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20"/>
        <quality shadowsize="8192"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.62 0.75 0.88" rgb2="0.95 0.95 0.98" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
            rgb1="0.88 0.90 0.92" rgb2="0.72 0.75 0.78" markrgb="0.60 0.63 0.66"
            width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.1"/>
        <!-- Mixed stairs: gentle stairs, steep stairs, random platforms, slopes -->
        <hfield name="hfield" file="assets/stairs_mixed_hfield.png" size="5 5 0.06 0.001"/>
    </asset>

    <worldbody>
        <body name="floor">
            <geom name="floor" type="hfield" hfield="hfield" material="groundplane" contype="1" conaffinity="0"
                priority="1" friction="0.8" condim="3"/>
        </body>
    </worldbody>

    <keyframe>
        <key name="home"
            qpos="
    0 0 0.40
    1 0 0 0
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
"
            ctrl="
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
      0.0
      0.67
      -1.3
"/>
    </keyframe>
</mujoco>
